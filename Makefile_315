CC = gcc
CFLAGS = -Wall -Wextra -pedantic -std=gnu11 -O2 -pthread

AGENT_SRC = agent_315.c
CONTROLLER_SRC = controller_315.c

AGENT_BIN = agent_315
CONTROLLER_BIN = controller_315

all: $(AGENT_BIN) $(CONTROLLER_BIN)

$(AGENT_BIN): $(AGENT_SRC)
	$(CC) $(CFLAGS) -o $(AGENT_BIN) $(AGENT_SRC)

$(CONTROLLER_BIN): $(CONTROLLER_SRC)
	$(CC) $(CFLAGS) -o $(CONTROLLER_BIN) $(CONTROLLER_SRC)

clean:
	rm -f $(AGENT_BIN) $(CONTROLLER_BIN) downloaded_*

rebuild: clean all

.PHONY: all clean rebuild
